{
  "$schema": "./secure-code-agent.schema.json",
  "version": 1,
  "paths": {
    "include_extensions": [
      ".py",
      ".js",
      ".jsx",
      ".ts",
      ".tsx",
      ".sh",
      ".yaml",
      ".yml",
      ".json",
      "Dockerfile"
    ],
    "exclude_patterns": [
      ".git/",
      "node_modules/",
      ".venv/",
      "venv/",
      "dist/",
      "build/",
      "**/__pycache__/",
      "**/*.min.js",
      "**/*.lock",
      "tests/",
      "src/secure_code_audit/scanners/builtin_rules.py",
      "src/secure_code_audit/standards.py",
      "src/secure_code_audit/remediation.py",
      "src/secure_code_audit/instructions.py",
      "src/secure_code_audit/suppressions.py",
      "docs/"
    ]
  },
  "scanners": {
    "pip_audit": {
      "enabled": true,
      "timeout_seconds": 300,
      "mode": "requirements",
      "inputs": [
        "requirements-audit.txt"
      ],
      "extra_args": [
        "--no-deps"
      ]
    },
    "bandit": {
      "enabled": true,
      "timeout_seconds": 600
    }
  },
  "gates": {
    "fail_on_severity": [
      "critical",
      "high"
    ],
    "fail_on_category": [
      "secrets"
    ],
    "fail_on_new": true,
    "min_score": 4.0,
    "require_scanners": [
      "floor"
    ],
    "max_unsuppressed": {
      "critical": 0,
      "high": 0
    }
  }
}
